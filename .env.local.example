# WarehousePro — Local Development Environment
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# HOW TO FIND THESE VALUES:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project → Settings → API

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Project → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE AUTH (client-side — safe to expose)
# ─────────────────────────────────────────────────────────────────────────────
# Project → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Project → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE SERVICE ROLE KEY (server-side ONLY — never expose to client)
# Used only by prisma/seed.ts to create auth users via Admin API.
# Project → Settings → API → Project API keys → service_role secret
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=eyJ...
